{
    "name": "q",
    "private": true,
    "version": "0.3.4",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": ">=1.1.0",
        "node": ">=20"
    },
    "scripts": {
        "dev": "vite dev",
        "build:ext": "BUILD_TARGET=extension bun run vite build && bun scripts/fix-extension-inline-scripts.js",
        "build:web": "BUILD_TARGET=web bun run vite build && bun scripts/clean-web-build.js",
        "preview:web": "bun run build:web && vite preview",
        "preview": "vite preview",
        "release": "bun scripts/release.js",
        "publish:edge": "bun scripts/edge-publish.js",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "verify": "bun run check && bun run lint && bun run test:unit",
        "test": "playwright test",
        "test:unit": "bun test tests",
        "test:unit:coverage": "bun test tests --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "playwright install chromium",
        "test:e2e:live": "E2E_LIVE=1 playwright test --project=live",
        "test:e2e:extension": "RUN_EXTENSION_E2E=1 E2E_NO_SERVER=1 bun run build:ext && playwright test --project=extension"
    },
    "devDependencies": {
        "@eslint/compat": "^1.4.1",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.49.2",
        "@sveltejs/vite-plugin-svelte": "^5.1.1",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.18",
        "@types/bun": "^1.4.2",
        "@vite-pwa/sveltekit": "^1.1.0",
        "bestzip": "^2.2.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.13.1",
        "globals": "^16.5.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.1",
        "svelte": "^5.46.0",
        "svelte-check": "^4.3.4",
        "sveltekit-adapter-chrome-extension": "^2.0.1",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.50.0",
        "vite": "^7.3.1"
    },
    "dependencies": {
        "@milkdown/crepe": "^7.17.3",
        "@milkdown/kit": "7.18.0",
        "dexie": "^4.2.1"
    }
}
